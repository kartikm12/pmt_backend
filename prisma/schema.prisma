generator client {
  provider        = "prisma-client-js"
  // One SQL query per request tree instead of one per related list: each database trip costs ~160 ms live
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MANAGER
  TEAM_MEMBER
  DEVELOPER
  DESIGNER
  TESTER
  SUPPORT_ENGINEER
  BUSINESS_ANALYST
  PROJECT_MANAGER
  ADMIN
}

enum MembershipRole {
  OWNER
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  OFFLINE
  SUSPENDED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityAction {
  USER_REGISTERED
  USER_LOGGED_IN
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  COMMENT_ADDED
  TEAM_MEMBER_INVITED
  TEAM_MEMBER_REMOVED
  PROFILE_UPDATED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  PROJECT_UPDATED
  TEAM_INVITE
  COMMENT_MENTION
  SYSTEM
  ASSET_ASSIGNED
  ASSET_RECEIPT_CONFIRMED
  ASSET_RECEIPT_PENDING
  ASSET_PROBLEM_REPORTED
  ASSET_WARRANTY_EXPIRING
  ASSET_COLLECTION_REQUIRED
  ASSET_RETURNED
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  LOST
  RETIRED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum AssetAssignmentReceiptStatus {
  PENDING
  CONFIRMED
}

enum AssetAssignmentCollectionStatus {
  NONE
  PENDING_COLLECTION
  COLLECTED
}

enum AssetEventType {
  CREATED
  UPDATED
  ASSIGNED
  RECEIPT_CONFIRMED
  RETURNED
  MARKED_FOR_REPAIR
  REPAIR_COMPLETED
  MARKED_LOST
  RETIRED
  DELETED
  RESTORED
  PROBLEM_REPORTED
  COLLECTION_REQUESTED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  // Set on every password change or reset; private to the person (hidden by default in src/prisma/client.ts)
  passwordChangedAt   DateTime?
  fullName            String
  avatarUrl           String?
  bio                 String?
  phone               String?
  title               String?
  role                UserRole             @default(TEAM_MEMBER)
  roleLocked          Boolean              @default(true)
  // Self sign-ups wait here until a manager approves them
  pendingApproval     Boolean              @default(false)
  // Assignment, due-date and mention emails (Settings → Notifications); account emails always go out
  emailNotifications  Boolean              @default(true)
  passwordResetTokens PasswordResetToken[]
  status              UserStatus           @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  managedProjects     Project[]            @relation("ProjectManager")
  assignedTasks       Task[]               @relation("TaskAssignees")
  createdTasks        Task[]               @relation("TaskCreator")
  comments            TaskComment[]
  memberships         ProjectMember[]
  attachments         Attachment[]
  activityLogs        ActivityLog[]
  notifications       Notification[]
  sessions            UserSession[]
  createdProjects     Project[]            @relation("ProjectCreator")
  watchedTasks        Task[]               @relation("TaskWatchers")
  timeEntries         TimeEntry[]
  // Reporting hierarchy
  reportsToId         String?
  reportsTo           User?                @relation("ReportingHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates        User[]               @relation("ReportingHierarchy")

  // Assets relations
  assignedAssets AssetAssignment[] @relation("UserAssetAssignments")
  heldAssets     Asset[]           @relation("CurrentAssetHolder")
  assetEvents    AssetEvent[]      @relation("UserAssetEvents")
  createdAssets  Asset[]           @relation("AssetCreator")

  @@index([role, deletedAt])
  @@index([status, deletedAt])
  @@index([reportsToId])
}

// "Forgot password" links: only a hash of the token is kept, each works once and expires
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id            String    @id
  userId        String
  userAgent     String?
  deviceInfo    String?
  ipAddress     String?
  isActive      Boolean   @default(true)
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([expiresAt])
}

model Project {
  id            String          @id
  name          String
  slug          String          @unique
  description   String?
  status        ProjectStatus   @default(PLANNING)
  startDate     DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  managerId     String
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  manager       User            @relation("ProjectManager", fields: [managerId], references: [id])
  createdBy     User            @relation("ProjectCreator", fields: [createdById], references: [id])
  tasks         Task[]
  members       ProjectMember[]
  attachments   Attachment[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  milestones    Milestone[]
  // The board's own columns (each counts as one of the four stages) and its rules
  columns       BoardColumn[]
  rules         ProjectRule[]
  assets        Asset[]         @relation("AssetProject")

  @@index([status, deletedAt])
  @@index([managerId, deletedAt])
  @@index([createdById])
  @@index([dueDate])
}

model ProjectMember {
  id        String         @id @default(cuid())
  projectId String
  userId    String
  role      MembershipRole @default(CONTRIBUTOR)
  joinedAt  DateTime       @default(now())
  removedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, removedAt])
  @@index([projectId, removedAt])
}

model Task {
  id                String         @id
  title             String
  description       String?
  status            TaskStatus     @default(TODO)
  priority          TaskPriority   @default(MEDIUM)
  dueDate           DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  sortOrder         Int            @default(0)
  // When the one-off "due soon" / "overdue" reminders went out; cleared when the due date changes
  dueSoonNotifiedAt DateTime?
  overdueNotifiedAt DateTime?
  // Planned start (timeline bars); null = starts when created
  startDate         DateTime?
  labels            String[]       @default([])
  estimateHours     Float?
  // "DAILY" | "WEEKLY" | "MONTHLY": finishing the task creates the next one (once; see nextOccurrenceId)
  recurrence        String?
  nextOccurrenceId  String?
  milestoneId       String?
  // The board column it sits in; status stays the stage that column counts as. null = the first column
  // of its stage (tasks saved before columns existed, or by an older app that only sends a status)
  columnId          String?
  projectId         String
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone         Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  column            BoardColumn?   @relation(fields: [columnId], references: [id], onDelete: SetNull)
  ruleRuns          RuleRun[]
  assignees         User[]         @relation("TaskAssignees")
  watchers          User[]         @relation("TaskWatchers")
  blockedBy         Task[]         @relation("TaskDependencies")
  blocks            Task[]         @relation("TaskDependencies")
  createdBy         User           @relation("TaskCreator", fields: [createdById], references: [id])
  comments          TaskComment[]
  attachments       Attachment[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  subtasks          Subtask[]
  timeEntries       TimeEntry[]

  @@index([projectId, status, deletedAt])
  @@index([dueDate, deletedAt])
  @@index([priority, status])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  minutes   Int
  note      String?
  spentOn   DateTime @default(now())
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, spentOn])
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
}

model TaskComment {
  id          String       @id @default(cuid())
  taskId      String
  userId      String
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([taskId, deletedAt])
  @@index([userId, deletedAt])
}

model ActivityLog {
  id          String         @id @default(cuid())
  action      ActivityAction
  entityType  String
  entityId    String
  description String
  metadata    Json?
  userId      String?
  projectId   String?
  taskId      String?
  createdAt   DateTime       @default(now())
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  projectId String?
  taskId    String?
  assetId   String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  asset     Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([assetId, createdAt])
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  fileType  String
  fileSize  Int
  projectId String?
  taskId    String?
  // Set when the file was attached to a comment (it still belongs to the task, so the Files tab shows it)
  commentId String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment TaskComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@index([commentId])
}

// A project's board column. "stage" is which of the four fixed statuses it counts as, so reports, the
// dashboard, the leaderboard and overdue alerts keep working whatever the columns are called.
model BoardColumn {
  id        String     @id @default(cuid())
  projectId String
  name      String
  stage     TaskStatus
  position  Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId, position])
}

// "When X happens (only if Y), then do Z" for one project. trigger/actions are plain strings and JSON
// (not database enums) so new kinds can be added without a database type change.
model ProjectRule {
  id           String    @id @default(cuid())
  projectId    String
  enabled      Boolean   @default(true)
  trigger      String
  triggerValue String?
  conditions   Json      @default("{}")
  actions      Json      @default("[]")
  runCount     Int       @default(0)
  lastRunAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs         RuleRun[]

  @@index([projectId, trigger, enabled])
}

// One rule firing on one task. For the time-based triggers the unique key makes each fire once
// (key = the due date it fired for, so a new due date can fire again).
model RuleRun {
  id        String      @id @default(cuid())
  ruleId    String
  taskId    String
  key       String
  createdAt DateTime    @default(now())
  rule      ProjectRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([ruleId, taskId, key])
  @@index([taskId])
}

model AssetCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assets      Asset[]

  @@index([name])
}

model Asset {
  id             String         @id @default(cuid())
  assetTag       String         @unique
  name           String
  categoryId     String
  category       AssetCategory  @relation(fields: [categoryId], references: [id])
  brand          String?
  model          String?
  serialNumber   String?        @unique
  specifications String?
  condition      AssetCondition @default(GOOD)
  status         AssetStatus    @default(IN_STOCK)
  location       String?

  // Purchase & Warranty
  purchaseDate           DateTime?
  purchaseCost           Float?
  vendorName             String?
  warrantyStartDate      DateTime?
  warrantyEndDate        DateTime?
  warrantyReminderSentAt DateTime?
  renewalReminderSentAt  DateTime?

  // Current Holder & Project
  currentHolderId String?
  currentHolder   User?    @relation("CurrentAssetHolder", fields: [currentHolderId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project? @relation("AssetProject", fields: [projectId], references: [id], onDelete: SetNull)

  // Creator & Soft Delete
  createdById String
  createdBy   User      @relation("AssetCreator", fields: [createdById], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments   AssetAssignment[]
  events        AssetEvent[]
  files         AssetFile[]
  notifications Notification[]

  @@index([status, deletedAt])
  @@index([categoryId, deletedAt])
  @@index([currentHolderId, deletedAt])
  @@index([warrantyEndDate])
  @@index([deletedAt])
}

model AssetAssignment {
  id                  String         @id @default(cuid())
  assetId             String
  userId              String
  projectId           String?
  assignedById        String
  assignedAt          DateTime       @default(now())
  assignmentCondition AssetCondition @default(GOOD)
  notes               String?

  // Receipt confirmation
  receiptStatus         AssetAssignmentReceiptStatus @default(PENDING)
  receiptConfirmedAt    DateTime?
  receiptReminderSentAt DateTime?

  // Return / Handover
  returnedAt        DateTime?
  returnCondition   AssetCondition?
  returnRemarks     String?
  returnDisposition String?
  returnedById      String?

  // Employee exit collection
  collectionStatus AssetAssignmentCollectionStatus @default(NONE)
  collectionNotes  String?

  // Active flag
  isCurrent Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation("UserAssetAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId, isCurrent])
  @@index([userId, isCurrent])
  @@index([receiptStatus, isCurrent])
  @@index([collectionStatus])
}

model AssetEvent {
  id            String         @id @default(cuid())
  assetId       String
  eventType     AssetEventType
  performedById String?
  title         String
  description   String
  metadata      Json?
  createdAt     DateTime       @default(now())

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User? @relation("UserAssetEvents", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([eventType])
}

model AssetFile {
  id           String   @id @default(cuid())
  assetId      String
  name         String
  url          String
  mimeType     String
  fileSize     Int
  uploadedById String
  createdAt    DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
}
